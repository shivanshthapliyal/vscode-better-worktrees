{
  "name": "better-worktrees",
  "displayName": "Better Worktrees",
  "description": "Manage git worktrees from the Explorer: live status, Source Control scoping, and safe removal.",
  "version": "0.4.4",
  "publisher": "shivanshthapliyal",
  "icon": "icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shivanshthapliyal/vscode-better-worktrees.git"
  },
  "bugs": {
    "url": "https://github.com/shivanshthapliyal/vscode-better-worktrees/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "worktree",
    "worktrees",
    "source control",
    "scm",
    "branch"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "betterWorktrees.createWorktree",
        "title": "New Worktree...",
        "category": "Worktrees",
        "icon": "$(add)"
      },
      {
        "command": "betterWorktrees.checkoutWorktree",
        "title": "Checkout Branch as Worktree...",
        "category": "Worktrees",
        "icon": "$(git-branch-create)"
      },
      {
        "command": "betterWorktrees.worktreeFromPullRequest",
        "title": "Worktree from Pull Request...",
        "category": "Worktrees",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "betterWorktrees.filterWorktrees",
        "title": "Filter Worktrees...",
        "category": "Worktrees",
        "icon": "$(search)"
      },
      {
        "command": "betterWorktrees.clearWorktreeFilter",
        "title": "Clear Worktree Filter",
        "category": "Worktrees",
        "icon": "$(search-stop)"
      },
      {
        "command": "betterWorktrees.toggleSortDirtyFirst",
        "title": "Toggle Dirty-First Sort",
        "category": "Worktrees",
        "icon": "$(sort-precedence)"
      },
      {
        "command": "betterWorktrees.worktree.fetch",
        "title": "Fetch",
        "category": "Worktrees",
        "icon": "$(cloud-download)"
      },
      {
        "command": "betterWorktrees.worktree.pull",
        "title": "Pull (fast-forward)",
        "category": "Worktrees",
        "icon": "$(arrow-down)"
      },
      {
        "command": "betterWorktrees.worktree.push",
        "title": "Push",
        "category": "Worktrees",
        "icon": "$(arrow-up)"
      },
      {
        "command": "betterWorktrees.openWorktree",
        "title": "Open Worktree...",
        "category": "Worktrees"
      },
      {
        "command": "betterWorktrees.refreshWorktrees",
        "title": "Refresh Worktrees",
        "category": "Worktrees",
        "icon": "$(refresh)"
      },
      {
        "command": "betterWorktrees.addWorktreesToSourceControl",
        "title": "Add Worktrees to Source Control",
        "category": "Worktrees",
        "icon": "$(source-control)"
      },
      {
        "command": "betterWorktrees.showAllWorktreesInSourceControl",
        "title": "Show All Worktrees in Source Control",
        "category": "Worktrees",
        "icon": "$(clear-all)"
      },
      {
        "command": "betterWorktrees.pruneWorktrees",
        "title": "Prune Stale Worktrees",
        "category": "Worktrees",
        "icon": "$(trash)"
      },
      {
        "command": "betterWorktrees.repairWorktrees",
        "title": "Repair Worktrees",
        "category": "Worktrees",
        "icon": "$(tools)"
      },
      {
        "command": "betterWorktrees.worktree.revealInSourceControl",
        "title": "Show Only This Worktree in Source Control",
        "category": "Worktrees",
        "icon": "$(source-control)"
      },
      {
        "command": "betterWorktrees.worktree.addToSourceControl",
        "title": "Add This Worktree to Source Control",
        "category": "Worktrees",
        "icon": "$(diff-added)"
      },
      {
        "command": "betterWorktrees.worktree.revealInExplorerView",
        "title": "Show in Explorer View",
        "category": "Worktrees",
        "icon": "$(list-tree)"
      },
      {
        "command": "betterWorktrees.worktree.openTerminal",
        "title": "Open Terminal at Worktree",
        "category": "Worktrees",
        "icon": "$(terminal)"
      },
      {
        "command": "betterWorktrees.worktree.openInNewWindow",
        "title": "Open in New Window",
        "category": "Worktrees",
        "icon": "$(empty-window)"
      },
      {
        "command": "betterWorktrees.worktree.openInCurrentWindow",
        "title": "Open in Current Window",
        "category": "Worktrees",
        "icon": "$(window)"
      },
      {
        "command": "betterWorktrees.worktree.addToWorkspace",
        "title": "Add Worktree to Workspace",
        "category": "Worktrees",
        "icon": "$(new-folder)"
      },
      {
        "command": "betterWorktrees.worktree.removeFromWorkspace",
        "title": "Remove Worktree from Workspace",
        "category": "Worktrees",
        "icon": "$(close)"
      },
      {
        "command": "betterWorktrees.worktree.reveal",
        "title": "Reveal in File Explorer",
        "category": "Worktrees",
        "icon": "$(folder-opened)"
      },
      {
        "command": "betterWorktrees.worktree.copyPath",
        "title": "Copy Worktree Path",
        "category": "Worktrees",
        "icon": "$(copy)"
      },
      {
        "command": "betterWorktrees.worktree.copyBranch",
        "title": "Copy Branch Name",
        "category": "Worktrees",
        "icon": "$(git-branch)"
      },
      {
        "command": "betterWorktrees.worktree.toggleLock",
        "title": "Lock / Unlock Worktree",
        "category": "Worktrees",
        "icon": "$(lock)"
      },
      {
        "command": "betterWorktrees.worktree.unlockInline",
        "title": "Unlock Worktree",
        "category": "Worktrees",
        "icon": "$(unlock)"
      },
      {
        "command": "betterWorktrees.worktree.move",
        "title": "Move Worktree...",
        "category": "Worktrees",
        "icon": "$(arrow-right)"
      },
      {
        "command": "betterWorktrees.worktree.remove",
        "title": "Remove Worktree...",
        "category": "Worktrees",
        "icon": "$(trash)"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "betterWorktrees.worktrees",
          "name": "Worktrees",
          "icon": "$(git-branch)",
          "contextualTitle": "Worktrees"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "betterWorktrees.worktrees",
        "contents": "No git worktrees found in this workspace.\nOpen a folder that is part of a git repository to see its worktrees here."
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "betterWorktrees.worktree.unlockInline",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "betterWorktrees.createWorktree",
          "when": "view == betterWorktrees.worktrees",
          "group": "navigation@1"
        },
        {
          "command": "betterWorktrees.filterWorktrees",
          "when": "view == betterWorktrees.worktrees && !betterWorktrees.filterActive",
          "group": "navigation@2"
        },
        {
          "command": "betterWorktrees.clearWorktreeFilter",
          "when": "view == betterWorktrees.worktrees && betterWorktrees.filterActive",
          "group": "navigation@2"
        },
        {
          "command": "betterWorktrees.showAllWorktreesInSourceControl",
          "when": "view == betterWorktrees.worktrees",
          "group": "navigation@3"
        },
        {
          "command": "betterWorktrees.refreshWorktrees",
          "when": "view == betterWorktrees.worktrees",
          "group": "navigation@4"
        },
        {
          "command": "betterWorktrees.checkoutWorktree",
          "when": "view == betterWorktrees.worktrees",
          "group": "1_create@1"
        },
        {
          "command": "betterWorktrees.worktreeFromPullRequest",
          "when": "view == betterWorktrees.worktrees",
          "group": "1_create@2"
        },
        {
          "command": "betterWorktrees.toggleSortDirtyFirst",
          "when": "view == betterWorktrees.worktrees",
          "group": "2_view@1"
        },
        {
          "command": "betterWorktrees.repairWorktrees",
          "when": "view == betterWorktrees.worktrees",
          "group": "3_manage@1"
        }
      ],
      "view/item/context": [
        {
          "command": "betterWorktrees.worktree.revealInExplorerView",
          "when": "view == betterWorktrees.worktrees && viewItem =~ /^worktree/",
          "group": "inline@1"
        },
        {
          "command": "betterWorktrees.worktree.openTerminal",
          "when": "view == betterWorktrees.worktrees && viewItem =~ /^worktree/",
          "group": "inline@2"
        },
        {
          "command": "betterWorktrees.worktree.toggleLock",
          "when": "view == betterWorktrees.worktrees && viewItem =~ /\\.unlocked/ && viewItem =~ /\\.lockable/",
          "group": "inline@3"
        },
        {
          "command": "betterWorktrees.worktree.unlockInline",
          "when": "view == betterWorktrees.worktrees && viewItem =~ /\\.locked/ && viewItem =~ /\\.lockable/",
          "group": "inline@3"
        },
        {
          "command": "betterWorktrees.worktree.remove",
          "when": "view == betterWorktrees.worktrees && viewItem =~ /\\.removable/",
          "group": "inline@4"
        },
        {
          "command": "betterWorktrees.worktree.revealInSourceControl",
          "when": "view == betterWorktrees.worktrees && viewItem =~ /^worktree/",
          "group": "1_open@1"
        },
        {
          "command": "betterWorktrees.worktree.addToSourceControl",
          "when": "view == betterWorktrees.worktrees && viewItem =~ /^worktree/",
          "group": "1_open@2"
        },
        {
          "command": "betterWorktrees.worktree.openInCurrentWindow",
          "when": "view == betterWorktrees.worktrees && viewItem =~ /^worktree/",
          "group": "1_open@3"
        },
        {
          "command": "betterWorktrees.worktree.openInNewWindow",
          "when": "view == betterWorktrees.worktrees && viewItem =~ /^worktree/",
          "group": "1_open@4"
        },
        {
          "command": "betterWorktrees.worktree.revealInExplorerView",
          "when": "view == betterWorktrees.worktrees && viewItem =~ /^worktree/",
          "group": "2_workspace@1"
        },
        {
          "command": "betterWorktrees.worktree.addToWorkspace",
          "when": "view == betterWorktrees.worktrees && viewItem =~ /^worktree/",
          "group": "2_workspace@2"
        },
        {
          "command": "betterWorktrees.worktree.removeFromWorkspace",
          "when": "view == betterWorktrees.worktrees && viewItem =~ /^worktree/",
          "group": "2_workspace@3"
        },
        {
          "command": "betterWorktrees.worktree.openTerminal",
          "when": "view == betterWorktrees.worktrees && viewItem =~ /^worktree/",
          "group": "3_actions@1"
        },
        {
          "command": "betterWorktrees.worktree.reveal",
          "when": "view == betterWorktrees.worktrees && viewItem =~ /^worktree/",
          "group": "3_actions@2"
        },
        {
          "command": "betterWorktrees.worktree.fetch",
          "when": "view == betterWorktrees.worktrees && viewItem =~ /^worktree/",
          "group": "3_git@1"
        },
        {
          "command": "betterWorktrees.worktree.pull",
          "when": "view == betterWorktrees.worktrees && viewItem =~ /^worktree/",
          "group": "3_git@2"
        },
        {
          "command": "betterWorktrees.worktree.push",
          "when": "view == betterWorktrees.worktrees && viewItem =~ /^worktree/",
          "group": "3_git@3"
        },
        {
          "command": "betterWorktrees.worktree.copyPath",
          "when": "view == betterWorktrees.worktrees && viewItem =~ /^worktree/",
          "group": "4_copy@1"
        },
        {
          "command": "betterWorktrees.worktree.copyBranch",
          "when": "view == betterWorktrees.worktrees && viewItem =~ /^worktree/",
          "group": "4_copy@2"
        },
        {
          "command": "betterWorktrees.worktree.toggleLock",
          "when": "view == betterWorktrees.worktrees && viewItem =~ /\\.lockable/",
          "group": "5_manage@1"
        },
        {
          "command": "betterWorktrees.worktree.move",
          "when": "view == betterWorktrees.worktrees && viewItem =~ /\\.removable/",
          "group": "5_manage@2"
        },
        {
          "command": "betterWorktrees.worktree.remove",
          "when": "view == betterWorktrees.worktrees && viewItem =~ /\\.removable/",
          "group": "5_manage@3"
        },
        {
          "command": "betterWorktrees.createWorktree",
          "when": "view == betterWorktrees.worktrees && viewItem =~ /^repo/",
          "group": "inline@1"
        },
        {
          "command": "betterWorktrees.pruneWorktrees",
          "when": "view == betterWorktrees.worktrees && viewItem == repo.hasStale",
          "group": "inline@2"
        },
        {
          "command": "betterWorktrees.createWorktree",
          "when": "view == betterWorktrees.worktrees && viewItem =~ /^repo/",
          "group": "1_repo@1"
        },
        {
          "command": "betterWorktrees.checkoutWorktree",
          "when": "view == betterWorktrees.worktrees && viewItem =~ /^repo/",
          "group": "1_repo@2"
        },
        {
          "command": "betterWorktrees.worktreeFromPullRequest",
          "when": "view == betterWorktrees.worktrees && viewItem =~ /^repo/",
          "group": "1_repo@3"
        },
        {
          "command": "betterWorktrees.addWorktreesToSourceControl",
          "when": "view == betterWorktrees.worktrees && viewItem =~ /^repo/",
          "group": "2_repo@1"
        },
        {
          "command": "betterWorktrees.pruneWorktrees",
          "when": "view == betterWorktrees.worktrees && viewItem =~ /^repo/",
          "group": "2_repo@2"
        },
        {
          "command": "betterWorktrees.repairWorktrees",
          "when": "view == betterWorktrees.worktrees && viewItem =~ /^repo/",
          "group": "2_repo@3"
        }
      ]
    },
